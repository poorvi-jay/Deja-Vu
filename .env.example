# Copy this file to .env and paste in the connection string from your
# FalkorDB Cloud dashboard. .env is gitignored, so your password never
# reaches GitHub.

# The easy way: paste the whole URL the dashboard gives you.
FALKOR_URL=falkor://falkordb:YOUR-PASSWORD@your-host.falkordb.io:61517

# The graph name. Anything you like; it is created on first write.
FALKOR_GRAPH=dejavu

# Alternative to FALKOR_URL, if you would rather set the parts separately.
# Leave FALKOR_URL blank or deleted if you use these.
# FALKOR_HOST=your-host.falkordb.io
# FALKOR_PORT=61517
# FALKOR_USER=falkordb
# FALKOR_PASSWORD=YOUR-PASSWORD
